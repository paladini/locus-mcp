{
  "name": "@locus-dev/mcp",
  "version": "0.1.1",
  "description": "Locus MCP server — agent-first LSP code intelligence for Cursor, Claude Code, and AI agents",
  "license": "MIT",
  "type": "module",
  "bin": {
    "locus": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paladini/locus-mcp.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/paladini/locus-mcp/issues"
  },
  "homepage": "https://github.com/paladini/locus-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "lsp",
    "language-server-protocol",
    "ai-agent",
    "code-intelligence",
    "cursor",
    "claude-code",
    "vscode",
    "typescript",
    "semantic-navigation"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@locus-dev/core": "*",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
