{
  "name": "@paladini/locus-core",
  "version": "0.1.3",
  "description": "LSP client, registry, symbol layer, and format utilities for Locus — MCP server for LSP code intelligence",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paladini/locus-mcp.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/paladini/locus-mcp/issues"
  },
  "homepage": "https://github.com/paladini/locus-mcp#readme",
  "keywords": [
    "lsp",
    "language-server-protocol",
    "mcp",
    "code-intelligence",
    "ai-agent",
    "typescript",
    "symbols"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
