# Install @locus-dev packages from GitHub Packages
# Copy to ~/.npmrc or project .npmrc

@locus-dev:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# Replace ${GITHUB_TOKEN} with a GitHub PAT that has read:packages scope.
# For CI, use the automatic GITHUB_TOKEN with packages:read on the repo.

# Default registry remains npmjs.org for all other scopes:
# registry=https://registry.npmjs.org/

# Example install:
#   npm install @locus-dev/mcp @locus-dev/core
